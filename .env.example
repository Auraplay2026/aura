# ==============================================================================
# AURAPLAY / BETMATRIX - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy these variables into your hosting platform (Render, Railway, Vercel, or VPS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE CONNECTION (Required)
# PostgreSQL connection string with SSL support (Supabase, Neon, AWS RDS, etc.)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. RUNTIME & NETWORKING (Required)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"
HOSTNAME="0.0.0.0"
NODE_OPTIONS="--max-old-space-size=512"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Required)
# Generate random 32+ character strings for production secrets
# ------------------------------------------------------------------------------
JWT_SECRET="aura_super_secure_jwt_secret_key_2026_change_in_production"
NEXTAUTH_SECRET="aura_nextauth_secret_key_2026_change_in_production"
NEXTAUTH_URL="https://aura-orsv.onrender.com"

# ------------------------------------------------------------------------------
# 4. ADMINISTRATIVE ACCESS & SEEDING (Required)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="twintubrovquattro@gmail.com"
ADMIN_DEFAULT_PASSWORD="AuraBetAdmin2026!"
ADMIN_SECURITY_KEY="AURAPLAY_MASTER_SECURE_ADMIN_KEY_2026"
MASTER_SECURITY_KEY="AURAPLAY_MASTER_SECURE_ADMIN_KEY_2026"

# ------------------------------------------------------------------------------
# 5. PUBLIC CLIENT VARIABLES (Optional / Customization)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://aura-orsv.onrender.com"
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER="+91 6290482750"

# ------------------------------------------------------------------------------
# 6. ADVANCED FLAGS (Optional)
# ------------------------------------------------------------------------------
# Set to 'true' only when running in production with HTTPS SSL configured
ENABLE_HSTS="false"
